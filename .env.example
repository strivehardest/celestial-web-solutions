# Environment Variables for Celestial Web Solutions Course Platform

# ===========================================
# PAYSTACK CONFIGURATION
# ===========================================
# Get these from your Paystack dashboard:
# https://dashboard.paystack.com/#/settings/developer

# Paystack Secret Key (Secret - DO NOT expose in frontend)
PAYSTACK_SECRET_KEY=your_paystack_secret_key_here

# Paystack Public Key (Public - can be used in frontend)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=your_paystack_public_key_here

# ===========================================
# APP CONFIGURATION
# ===========================================
# Your app URL (for redirects)
NEXT_PUBLIC_APP_URL=https://celestialwebsolutions.net

# ===========================================
# SETUP INSTRUCTIONS
# ===========================================
# 1. Copy this file to .env.local
# 2. Fill in your actual Paystack values
# 3. Never commit .env.local to git
# 4. Restart your Next.js dev server after changes

# ===========================================
# CELESTIAL AI (pages/celestial-ai)
# ===========================================
# Optional. No key is required: without one, Celestial AI answers from the
# built-in knowledge base in lib/celestialAI (English only).
# To enable a live, multilingual language model, set ONE of these. Free tiers
# with no card needed: Groq (https://console.groq.com/keys) and Google AI Studio
# (https://aistudio.google.com/apikey).
# GROQ_API_KEY=gsk_...
# GEMINI_API_KEY=AIza...
# OPENAI_API_KEY=sk-...
# OPENROUTER_API_KEY=sk-or-...
# Optional overrides
# CELESTIAL_AI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions

# ===========================================
# CLOUDFLARE TURNSTILE (CAPTCHA)
# ===========================================
# Get these from: https://dash.cloudflare.com → Turnstile → Add Site

# Turnstile Site Key (Public - used in frontend widget)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key_here

# Turnstile Secret Key (Secret - server-side verification only)
TURNSTILE_SECRET_KEY=your_turnstile_secret_key_here
